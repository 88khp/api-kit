# Turso database (get these from: turso db show api-kit-demo --url && turso db tokens create api-kit-demo)
TURSO_URL=libsql://api-kit-demo-rishav-jha-mech.aws-ap-south-1.turso.io
TURSO_TOKEN=your-token-here

# For local dev without Turso, use a local file instead:
# TURSO_URL=file:./data/demo.db
# TURSO_TOKEN=

# JWT signing secret — change this in production
JWT_SECRET=super-secret-dev-key-change-in-prod

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Token lifetimes (jsonwebtoken format: 30s, 15m, 7d, etc.)
ACCESS_TOKEN_TTL=30s
REFRESH_TOKEN_TTL=1d
