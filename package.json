{
  "name": "@devraj-labs/api-kit",
  "version": "1.0.0",
  "description": "Production-grade, platform-agnostic Axios API client with automatic token refresh",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
